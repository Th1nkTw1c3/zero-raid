# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
# OAuth consent screen must have Gmail API enabled and scope gmail.modify authorized.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: override the OAuth redirect URI. Defaults to {request origin}/api/callback.
# Register http://localhost:5173/api/callback AND your prod URL /api/callback in Google.
GOOGLE_REDIRECT_URI=

# Any long random string. Used to encrypt the session cookie.
SESSION_SECRET=

# Optional: force demo mode even when OAuth creds exist (DEMO_MODE=1)
DEMO_MODE=
